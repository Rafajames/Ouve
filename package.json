{
  "name": "ouve",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @ouve/desktop dev",
    "build:desktop": "pnpm --filter @ouve/desktop build",
    "build:extension": "pnpm --filter @ouve/extension build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm --filter @ouve/desktop test:e2e && pnpm --filter @ouve/extension test:e2e && pnpm --filter @ouve/web test:e2e",
    "build:web": "pnpm --filter @ouve/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^17.14.0",
    "prettier": "^3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8",
    "vitest": "^2.1.8"
  },
  "type": "module",
  "author": "Rafajames"
}
