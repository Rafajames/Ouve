{
  "name": "@ouve/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --dir test",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@ouve/analysis": "workspace:^",
    "@ouve/capture": "workspace:^",
    "@ouve/core": "workspace:*",
    "@ouve/providers": "workspace:^",
    "@ouve/reports": "workspace:^",
    "@ouve/shared": "workspace:^",
    "@ouve/transcription": "workspace:^",
    "@ouve/ui": "workspace:^",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "author": "Rafajames"
}
