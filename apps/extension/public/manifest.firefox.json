{
  "manifest_version": 3,
  "name": "Ouve — Assistente de áudio",
  "version": "0.1.0",
  "description": "Transcreva e organize o áudio de reuniões e audiências.",
  "action": { "default_popup": "popup.html" },
  "background": { "scripts": ["background.js"] },
  "permissions": ["storage", "activeTab"],
  "browser_specific_settings": {
    "gecko": { "id": "ouve-audio-assistant@example.invalid", "strict_min_version": "128.0" }
  }
}